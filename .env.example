# Production cloud database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/harborpos
PGSSLMODE=require
SESSION_SECRET=replace-with-a-long-random-secret
PORT=8787
SMS_ENABLER_TOKEN=replace-with-a-random-webhook-token

